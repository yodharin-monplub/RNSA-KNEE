# ==============================================================================
# Environment Configuration Template
# Copy this file to `Other/.env` and populate your credentials.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# --- Kaggle API Credentials ---
# Standard Kaggle API token or credentials mapped per team account:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Multiple team account tokens (used by orchestrator scripts in Other/tools):
KAGGLE_API_KEY_account1@example.com=your_kaggle_token_account_1
KAGGLE_API_KEY_account2@example.com=your_kaggle_token_account_2

# --- Cloud GPU Services ---
# Vast.ai API key for on-demand GPU cloud workers
VAST_AI_API_KEY=your_vast_ai_api_key

# --- Large Language Model APIs (Used for radiology report extraction & relabeling) ---
# OpenRouter API key for LLM re-labeling experiments
OPENROUTER_API_KEY=your_openrouter_api_key

# Anthropic Claude API key for report parsing & annotation verification
Claude_API=your_anthropic_api_key

# --- Notifications & Bot Monitoring ---
# Discord Bot Token for training progress and submission alerts
Discord_RNSA_BOT=your_discord_bot_token
DISCORD_CHANNEL_ID=your_discord_channel_id
